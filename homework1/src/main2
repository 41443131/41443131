#include <iostream>
using namespace std;
int a(int m, int n)
{
	int x[10000];
	int top = -1;
	x[++top] = m;//push
	while (top >= 0)
	{
		m = x[top--];//pop
		if (m == 0)
		{
			n += 1;
		}
		else if (n == 0)
		{
			n = 1;
			x[++top] = m - 1;
		}
		else
		{
			n -= 1;
			x[++top] = m - 1;//LIFO
			x[++top] = m;
		}
	}
	return n;
}
int main()
{
	int m = 0, n = 0;
	cin >> m >> n;
	cout << a(m, n) << endl;
	return 0;
}
